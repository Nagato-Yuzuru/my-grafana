# `op run --env-file` for tofu. All values are 1Password references (resolved at runtime,
# never on disk) — safe to commit. Adjust vault/item names to match your setup.
TF_VAR_stack_slug=op://Homelab/Grafana Cloud tofu state/username
TF_VAR_grafana_cloud_access_policy_token=op://Homelab/Grafana Cloud Bootstrap/credential
TF_VAR_state_passphrase=op://Homelab/Grafana Cloud tofu state/password
# R2 remote-state backend (S3 API). Standard AWS SDK env vars → the s3 backend authenticates
# and locates the endpoint without either landing on disk. AWS_ENDPOINT_URL_S3 fills
# endpoints.s3 in tofu/backend.tf; it must be the account-level endpoint
# (https://<account-id>.r2.cloudflarestorage.com) with no bucket path — use_path_style already
# appends the bucket, so a bucket-scoped URL doubles it and 404s.
AWS_ACCESS_KEY_ID=op://Homelab/Cloudflare R2 tofu state/AK
AWS_SECRET_ACCESS_KEY=op://Homelab/Cloudflare R2 tofu state/SK
AWS_ENDPOINT_URL_S3=op://Homelab/Cloudflare R2 tofu state/add more/S3URL
