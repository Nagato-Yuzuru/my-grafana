root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Justfile]
indent_size = 4

# alloy fmt's canonical style is tab indentation.
[*.alloy]
indent_style = tab

# Trailing double-space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
